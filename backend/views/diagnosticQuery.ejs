<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form id="aiForm" class="mt-6 bg-gray-100/20 p-6 rounded shadow-md w-full max-w-md">
  <label for="prompt" class="block mb-2 font-semibold text-gray-700">
    Enter your prompt:
  </label>
  <textarea id="prompt" name="prompt" 
    class="w-full p-3 border rounded focus:ring-2 focus:ring-blue-400 focus:outline-none"
    rows="4" placeholder="Type your question or command here..."></textarea>

  <button type="submit"
    class="mt-4 bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600 transition flex items-center">
    <i class="fa fa-bolt mr-2" aria-hidden="true"></i>
    Send to AI
  </button>

  <script src="../scripts/diagnoticsQuery.js"></script>
</form>

</body>
</html>